# ====================================================================
# CHÉP KINH ONLINE - FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# ====================================================================
# Sao chép tệp này thành `.env` hoặc `.env.production` trên môi trường chạy frontend:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ====================================================================

# 1. Địa chỉ API Backend (.NET 8 Web API)
# Development local: http://localhost:5000/api
# Production (IP hoặc Domain Backend VPS): https://api.chepkinh.vn/api hoặc https://your-backend-vps-ip:5000/api
VITE_API_URL=http://localhost:5000/api

# 2. Google OAuth 2.0 Client ID (dùng cho tính năng Đăng nhập bằng Google)
# Tạo tại Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Thêm Authorized JavaScript Origins: http://localhost:5174, https://chepkinh.vn
VITE_GOOGLE_CLIENT_ID=997339088254-e3v8rpclgleadehklk79euvve29s0n6r.apps.googleusercontent.com
